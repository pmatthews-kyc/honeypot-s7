# ── Live configuration (contains deployment-specific identity) ──────────────
# Ship config.yaml.example; keep your real config out of the repo. The real
# file holds your serial number, plant id, network specifics — all of which
# should be unique per deployment and never committed.
config.yaml

# ── Runtime state (regenerated at startup, deployment-specific) ─────────────
*.json
!package.json
cpu_state.json
network_state.json
process_state.json
mac_spoof_state.json

# ── Captured attacker data — NEVER commit ───────────────────────────────────
*.pcap
*.pcapng
commands.jsonl
diag_events.jsonl
honeypot.db
honeypot.db-*
/var/lib/s7honeypot/
/mnt/s7honeypot-data/

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
env/

# ── OS / editor ─────────────────────────────────────────────────────────────
.DS_Store
*.swp
*~
.idea/
.vscode/

# ── Generated systemd units (regenerated by generate_services.py) ───────────
deploy/systemd/*.service
